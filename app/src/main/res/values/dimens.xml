<?xml version="1.0" encoding="utf-8"?>
<!-- Escala de espaciado del proyecto (múltiplos de 8dp). Ningún layout hardcodea dp. -->
<resources>
    <dimen name="espaciado_minimo">8dp</dimen>
    <dimen name="espaciado_campo">16dp</dimen>
    <dimen name="espaciado_pantalla">24dp</dimen>
    <dimen name="espaciado_seccion">32dp</dimen>
    <!-- Mínimo táctil recomendado por Material/Accesibilidad — ver contexto/50 - Referencia/Accesibilidad Android.md -->
    <dimen name="altura_minima_tactil">48dp</dimen>
    <!-- Miniatura de la foto en la lista del menú (Fase 2a). -->
    <dimen name="foto_platillo_lista">72dp</dimen>
    <!-- Previsualización de la foto dentro del formulario de platillo. -->
    <dimen name="foto_platillo_formulario">160dp</dimen>
    <dimen name="radio_esquina_tarjeta">12dp</dimen>
    <!-- Tarjeta del platillo: esquina más suave que el resto, es la pieza protagonista. -->
    <dimen name="radio_esquina_tarjeta_grande">20dp</dimen>
    <!-- Radio "pastilla": cualquier valor mayor a la mitad del alto redondea del todo. -->
    <dimen name="radio_pastilla">100dp</dimen>
    <!-- Foto cuadrada en la tarjeta de platillo — 150dp exactos, del mockup del ítem. -->
    <dimen name="foto_platillo_tarjeta">150dp</dimen>
    <!-- Ancho/alto mínimo de la insignia circular del precio (mockup: 38px = 38dp). -->
    <dimen name="precio_pastilla_minimo">38dp</dimen>
    <!-- Deja respirar el último ítem de la lista por debajo del FAB. -->
    <dimen name="espaciado_lista_bajo_fab">88dp</dimen>

    <!--
      Medidas calcadas de "Restaurant App v2.dc.html" (Claude Design). El diseño está
      hecho sobre un lienzo de 402 px de ancho, que es exactamente el ancho lógico de un
      teléfono moderno: 1 px del mockup = 1 dp acá, sin conversión.
    -->
    <!-- El menú respira 20dp a los lados, no los 24dp del resto de la app. -->
    <dimen name="espaciado_menu">20dp</dimen>
    <!-- Radio de la tarjeta de platillo (20px en el mockup). -->
    <dimen name="radio_tarjeta_platillo">20dp</dimen>
    <!-- Pastilla del buscador y tarjetas blancas secundarias. -->
    <dimen name="radio_busqueda">16dp</dimen>
    <dimen name="radio_tarjeta_categoria">14dp</dimen>
    <!-- Esquinas superiores de las hojas modales (26px en el mockup). -->
    <dimen name="radio_hoja_modal">26dp</dimen>
    <!-- Borde de los chips de filtro y de los campos: 1.5px en el mockup. -->
    <dimen name="borde_control">1.5dp</dimen>
    <!--
      Alto visual del chip de filtro. Queda por debajo de altura_minima_tactil a
      propósito: el área tocable se estira a 48dp con app:ensureMinTouchTargetSize,
      así el chip se ve como el mockup sin romper accesibilidad.
    -->
    <dimen name="chip_filtro_alto">36dp</dimen>
    <!-- Botón redondo de cerrar de las hojas modales. -->
    <dimen name="boton_cerrar_modal">32dp</dimen>
</resources>
