<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema de la app con la paleta "Terracota Cálido" (Material 3).
         Los colores se resuelven por configuración: values-night/colors.xml
         define la variante oscura con los mismos nombres. -->
    <style name="Base.Theme.ProyectoFinalRestaurante" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/brand_on_error</item>
    </style>

    <style name="Theme.ProyectoFinalRestaurante" parent="Base.Theme.ProyectoFinalRestaurante" />

    <!--
      La Toolbar pinta su fondo con colorPrimary (terracota) a mano en el layout, pero
      MaterialToolbar no deriva colorControlNormal de colorOnPrimary por su cuenta: el
      ícono de hamburguesa (ActionBarDrawerToggle) y los íconos de acción (ic_campana,
      que usa android:tint="?attr/colorControlNormal") caían al valor por defecto del
      tema —oscuro, para la superficie clara— y quedaban sin contraste sobre la barra
      oscura. Este overlay fuerza colorControlNormal a colorOnPrimary (blanco) para esa
      Toolbar únicamente.
    -->
    <style name="ThemeOverlay.App.Toolbar" parent="">
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
    </style>

    <!-- Esquinas de las fotos de platillo, para que acompañen el radio de las tarjetas. -->
    <style name="EsquinaRedondeadaFoto">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_esquina_tarjeta</item>
    </style>
</resources>
