<?xml version="1.0" encoding="utf-8"?>
<!--
  Paleta "Terracota Cálido" — valores tomados del diseño aprobado
  (Claude Design, "Restaurant App v2.dc.html"). Ver contexto/40 - Proyecto
  Restaurante/Guía de Diseño Visual.md
-->
<resources>
    <color name="brand_primary">#a8452d</color>
    <color name="brand_on_primary">#FFFFFF</color>
    <color name="brand_primary_container">#f6dcce</color>
    <color name="brand_on_primary_container">#6b4a3a</color>
    <color name="brand_secondary">#8a5a45</color>
    <color name="brand_on_secondary">#FFFFFF</color>
    <color name="brand_surface">#f7ece7</color>
    <color name="brand_surface_variant">#fbf3ee</color>
    <color name="brand_surface_card">#FFFFFF</color>
    <color name="brand_on_surface">#241c19</color>
    <color name="brand_on_surface_variant">#8a7a74</color>
    <color name="brand_outline">#f0dccf</color>
    <color name="brand_error">#9a4a42</color>
    <color name="brand_on_error">#FFFFFF</color>

    <!--
      Tokens tomados literalmente de "Restaurant App v2.dc.html" (Claude Design). El
      diseño usa estos tonos en un solo lugar cada uno, por eso no entran en la escala
      Material principal de arriba: son piezas concretas, no roles semánticos.
    -->
    <!-- Fondo de la tarjeta de platillo — más cálido que brand_primary_container. -->
    <color name="brand_tarjeta_platillo">#f7dfd4</color>
    <!-- Borde del botón "Cancelar" en las hojas modales. -->
    <color name="brand_borde_cancelar">#e8d4c8</color>
    <!-- Borde punteado del botón "+ Agregar categoría". -->
    <color name="brand_borde_punteado">#d9b39d</color>
    <!--
      Separadores internos de tarjeta: el diseño usa rgba(36,28,25,0.08). En Android el
      alfa va primero, así que 0.08 * 255 = 20 = 0x14 → #14 + el hex de brand_on_surface.
    -->
    <color name="brand_separador">#14241C19</color>

    <!--
      Estados de pedido y mesa. Nunca se comunican solo con color: siempre van
      acompañados del texto del estado (ver Accesibilidad Android).
    -->
    <color name="estado_pendiente">#b0762a</color>
    <color name="estado_preparacion">#5a6b7d</color>
    <color name="estado_listo">#4f8a5b</color>
    <color name="estado_entregado">#8a7a74</color>
    <color name="estado_cancelado">#9a4a42</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
