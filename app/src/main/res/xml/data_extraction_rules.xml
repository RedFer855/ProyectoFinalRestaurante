<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!--
        P-009: excluir el SharedPreferences de AlmacenSeguro (nombre "almacen_seguro", ver
        core/AlmacenSeguro.java) del backup/restore y de la transferencia entre dispositivos.
        El valor que guarda está cifrado con una clave del Android Keystore que NUNCA se
        exporta, así que restaurado en otro dispositivo (o el mismo, reinstalado) sería un
        texto cifrado indescifrable — AlmacenSeguro.leer() ya lo trataría como corrupto y lo
        borraría solo, pero es más prolijo no restaurar basura en primer lugar.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="almacen_seguro.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="almacen_seguro.xml"/>
    </device-transfer>
</data-extraction-rules>