<?xml version="1.0" encoding="utf-8"?>
<!--
  Lápiz de "Editar" al pie de la tarjeta de platillo. Es el trazo exacto del SVG del
  mockup (viewBox 14x14, grosor 1.4, sin relleno), a 11dp como ahí.

  Existe aparte de @drawable/ic_editar porque el tamaño de un drawable compuesto
  (drawableStart) lo define su tamaño intrínseco: con el ícono de 24dp la fila de
  acciones no daba la proporción del diseño. Sin android:tint propio — lo tiñe el
  TextView que lo usa.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="11dp"
    android:height="11dp"
    android:viewportWidth="14"
    android:viewportHeight="14">
    <path
        android:pathData="M1,13 L1.6,10.2 L9.5,2.3 C9.9,1.9 10.5,1.9 10.9,2.3 L11.7,3.1 C12.1,3.5 12.1,4.1 11.7,4.5 L3.8,12.4 L1,13 Z"
        android:strokeColor="#FF000000"
        android:strokeLineJoin="round"
        android:strokeWidth="1.4" />
</vector>
