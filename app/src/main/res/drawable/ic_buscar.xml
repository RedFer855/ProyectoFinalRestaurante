<?xml version="1.0" encoding="utf-8"?>
<!--
  Lupa del buscador, trazada igual que el SVG del mockup: círculo r=6 centrado en (7,7)
  y mango de (11.5,11.5) a (16,16), trazo de 2. Se deja en negro y se tiñe desde el
  layout con app:tint, así el mismo vector sirve en claro y en oscuro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="16dp"
    android:viewportWidth="17"
    android:viewportHeight="17">
    <path
        android:pathData="M1,7 A6,6 0 1,0 13,7 A6,6 0 1,0 1,7"
        android:strokeColor="#FF000000"
        android:strokeWidth="2" />
    <path
        android:pathData="M11.5,11.5 L16,16"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
</vector>
