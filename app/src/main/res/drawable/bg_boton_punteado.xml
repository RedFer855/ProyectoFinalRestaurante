<?xml version="1.0" encoding="utf-8"?>
<!--
  Botón "+ Agregar categoría": pastilla vacía con borde punteado. El dash necesita
  <solid> transparente explícito; sin él algunos fabricantes rellenan la figura de negro.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/borde_control"
        android:color="@color/brand_borde_punteado"
        android:dashGap="4dp"
        android:dashWidth="6dp" />
    <corners android:radius="@dimen/radio_pastilla" />
</shape>
