<?xml version="1.0" encoding="utf-8"?>
<!--
  Caja del selector de foto cuando todavía no hay ninguna. Borde punteado para que se lea
  como "acá falta algo, tocá" y no como una imagen rota — el mockup pone ahí el texto
  "Arrastra o toca para subir foto".

  El <solid> transparente es necesario: sin él, algunos fabricantes rellenan de negro una
  figura con borde punteado.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_surface_variant" />
    <stroke
        android:width="@dimen/borde_control"
        android:color="@color/brand_borde_punteado"
        android:dashGap="4dp"
        android:dashWidth="6dp" />
    <corners android:radius="@dimen/radio_tarjeta_categoria" />
</shape>
