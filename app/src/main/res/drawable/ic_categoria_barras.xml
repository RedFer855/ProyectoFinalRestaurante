<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono de la pastilla de categoría dentro de la tarjeta: tres barras verticales, la
  última más alta. Calcado del SVG del mockup (viewBox 8x9, barras de 1.6 de ancho en
  x=0, 3.2 y 6.4; las dos primeras de alto 6 y la tercera de 9).

  Es decorativo — acompaña al nombre de la categoría, que ya se lee. Por eso el TextView
  que lo usa no declara contentDescription aparte.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="7dp"
    android:height="8dp"
    android:viewportWidth="8"
    android:viewportHeight="9">
    <path
        android:fillColor="#FF000000"
        android:pathData="M0,0 h1.6 v6 h-1.6 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M3.2,0 h1.6 v6 h-1.6 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M6.4,0 h1.6 v9 h-1.6 z" />
</vector>
