<?xml version="1.0" encoding="utf-8"?>
<!--
  Empleados: el módulo más sensible de la app. Solo admin lo ve — para los demás
  roles ni siquiera aparece en el menú lateral, y del lado del servidor las policies
  RLS lo bloquean aunque alguien modificara el APK (ver Plan Fase 1c, S-2).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_buscar_empleado"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/espaciado_pantalla"
            android:layout_marginTop="@dimen/espaciado_campo"
            android:hint="@string/empleados_buscar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_buscar_empleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
          Banner del estado de sincronización: solo aparece cuando hay algo que decir
          (sincronizando, cambios sin subir, o un error permanente de la última pasada).
        -->
        <TextView
            android:id="@+id/txt_estado_sync_empleados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/espaciado_pantalla"
            android:layout_marginTop="@dimen/espaciado_minimo"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="2 cambios sin subir"
            tools:visibility="visible" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresco_empleados"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_empleados"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/espaciado_pantalla"
                android:paddingTop="@dimen/espaciado_campo"
                android:paddingBottom="@dimen/espaciado_lista_bajo_fab"
                tools:itemCount="4"
                tools:listitem="@layout/item_empleado" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txt_empleados_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/espaciado_seccion"
        android:text="@string/empleados_vacio"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_empleados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_agregar_empleado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/espaciado_pantalla"
        android:text="@string/empleados_agregar"
        app:icon="@drawable/ic_agregar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
