<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/espaciado_minimo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_nombre_linea_carrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Bandeja típica" />

        <TextView
            android:id="@+id/txt_subtotal_linea_carrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_campo"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="L 90.00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_minimo"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menos_linea_carrito"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/carrito_cd_decrementar"
            android:minWidth="@dimen/altura_minima_tactil"
            android:minHeight="@dimen/altura_minima_tactil"
            android:text="@string/carrito_decrementar" />

        <TextView
            android:id="@+id/txt_cantidad_linea_carrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/espaciado_campo"
            android:gravity="center"
            android:minWidth="@dimen/espaciado_seccion"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mas_linea_carrito"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/carrito_cd_incrementar"
            android:minWidth="@dimen/altura_minima_tactil"
            android:minHeight="@dimen/altura_minima_tactil"
            android:text="@string/carrito_incrementar" />

        <TextView
            android:id="@+id/btn_quitar_linea_carrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_campo"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/carrito_cd_quitar"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/altura_minima_tactil"
            android:text="@string/carrito_quitar"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/brand_error"
            app:drawableStartCompat="@drawable/ic_cerrar"
            app:drawableTint="@color/brand_error" />
    </LinearLayout>

</LinearLayout>