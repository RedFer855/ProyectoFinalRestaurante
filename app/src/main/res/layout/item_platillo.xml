<?xml version="1.0" encoding="utf-8"?>
<!--
  Fila de un platillo del menú (Fase 2a). Un platillo desactivado no se esconde: se atenúa
  y se le pone la etiqueta "Desactivado", porque el admin tiene que poder reactivarlo.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaciado_minimo"
    app:cardBackgroundColor="@color/brand_surface_card"
    app:cardCornerRadius="@dimen/radio_esquina_tarjeta"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/espaciado_campo">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_platillo"
            android:layout_width="@dimen/foto_platillo_lista"
            android:layout_height="@dimen/foto_platillo_lista"
            android:layout_marginEnd="@dimen/espaciado_campo"
            android:background="@color/brand_surface_variant"
            android:contentDescription="@string/menu_cd_foto_platillo"
            android:padding="@dimen/espaciado_campo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_platillo_sin_foto"
            app:shapeAppearanceOverlay="@style/EsquinaRedondeadaFoto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_nombre_platillo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Pollo con tajadas" />

            <TextView
                android:id="@+id/txt_categoria_platillo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary"
                tools:text="Platos fuertes" />

            <TextView
                android:id="@+id/txt_estado_platillo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_minimo"
                android:text="@string/menu_platillo_desactivado"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/txt_descripcion_platillo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_minimo"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Pechuga a la plancha, tajadas de plátano y repollo" />

            <TextView
                android:id="@+id/txt_precio_platillo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_minimo"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="L 145.00" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_opciones_platillo"
            android:layout_width="@dimen/altura_minima_tactil"
            android:layout_height="@dimen/altura_minima_tactil"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_mas_opciones"
            android:src="@drawable/ic_mas_opciones" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
