<?xml version="1.0" encoding="utf-8"?>
<!--
  Tarjeta de un platillo — calcada del ítem de "Restaurant App v2.dc.html" (Claude
  Design), bloque sc-for filteredDishes.

  Medidas del mockup, 1 px = 1 dp: tarjeta radio 20, foto 150x150 pegada al borde
  izquierdo, columna de contenido con padding 10/12/8/11, nombre + insignia de precio de
  38 arriba, pastilla blanca de categoría a 2 de separación, descripción a 3 líneas con
  interlineado 1.35, y al pie una fila de acciones con separador superior.

  Tres desviaciones conscientes:

  - Alto: el mockup fija 150px. Acá es `minHeight`, no alto fijo, para que la tarjeta
    crezca en vez de recortar el texto cuando el usuario sube la fuente del sistema.
  - La segunda acción dice "Desactivar", nunca "Eliminar" como en el mockup: un trigger
    del servidor rechaza el DELETE de un platillo porque borrarlo rompería el historial
    de pedidos. Un platillo desactivado no se esconde: se atenúa (ver PlatilloAdapter) y
    se marca con la etiqueta "Desactivado", porque el admin tiene que poder reactivarlo.
  - Las etiquetas de estado y de sincronización no existen en el mockup (la demo no es
    offline-first ni tiene roles), pero acá son información funcional.

  Las acciones son TextView con drawableStart y no MaterialButton: el botón de Material
  trae insets propios que impedían clavar el 10.5sp con separación de 4 del diseño, y de
  paso esto ahorra dos niveles de jerarquía por tarjeta — que en una lista es justo donde
  se paga (ver Presupuestos de Rendimiento en Gama Baja).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/brand_tarjeta_platillo"
    app:cardCornerRadius="@dimen/radio_tarjeta_platillo"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/foto_platillo_tarjeta"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_platillo"
            android:layout_width="@dimen/foto_platillo_tarjeta"
            android:layout_height="@dimen/foto_platillo_tarjeta"
            android:background="@color/brand_surface_variant"
            android:contentDescription="@string/menu_cd_foto_platillo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_platillo_sin_foto"
            tools:src="@drawable/ic_platillo_sin_foto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/espaciado_minimo">

            <!-- Fila superior: nombre a la izquierda, insignia de precio a la derecha. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_nombre_platillo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espaciado_minimo"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.App.NombrePlatillo"
                    android:textColor="@color/brand_on_surface"
                    tools:text="Asado de Res" />

                <!--
                  Ancho mínimo igual al alto: con "L 240.00" la insignia se ve circular
                  como en el mockup, y con un precio largo se estira a pastilla en vez de
                  recortar el texto.
                -->
                <TextView
                    android:id="@+id/txt_precio_platillo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_precio_platillo"
                    android:gravity="center"
                    android:minWidth="@dimen/precio_pastilla_minimo"
                    android:minHeight="@dimen/precio_pastilla_minimo"
                    android:paddingHorizontal="@dimen/espaciado_minimo"
                    android:textAppearance="@style/TextAppearance.App.PrecioPlatillo"
                    android:textColor="@color/brand_on_primary"
                    tools:text="L 240.00" />
            </LinearLayout>

            <!-- Pastilla blanca de categoría, más estado y sincronización a su lado. -->
            <LinearLayout
                android:id="@+id/grupo_etiquetas_platillo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_categoria_platillo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_categoria_platillo"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/espaciado_minimo"
                    android:paddingVertical="3dp"
                    android:textAppearance="@style/TextAppearance.App.EtiquetaCategoria"
                    android:textColor="@color/brand_on_primary_container"
                    app:drawableStartCompat="@drawable/ic_categoria_barras"
                    app:drawableTint="@color/brand_on_primary_container"
                    tools:text="Platos Fuertes" />

                <TextView
                    android:id="@+id/txt_estado_platillo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaciado_minimo"
                    android:text="@string/menu_platillo_desactivado"
                    android:textAppearance="@style/TextAppearance.App.EtiquetaCategoria"
                    android:textColor="@color/brand_error"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/txt_sync_platillo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaciado_minimo"
                    android:text="@string/sync_pendiente"
                    android:textAppearance="@style/TextAppearance.App.EtiquetaCategoria"
                    android:textColor="@color/brand_on_surface_variant"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_descripcion_platillo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.35"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.App.DescripcionPlatillo"
                android:textColor="@color/brand_on_surface_variant"
                tools:text="Corte especial a la parrilla servido con papas cambray al romero y verduras asadas al gratín." />

            <!-- Empuja las acciones al fondo, igual que el flex:1 vacío del mockup. -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!--
              Separador + acciones. El grupo entero se oculta cuando el rol no puede ni
              editar ni desactivar (mesero y cocina solo consultan la carta), y la tarjeta
              se encoge sola.
            -->
            <LinearLayout
                android:id="@+id/grupo_acciones_platillo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_separador_superior"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/btn_editar_platillo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/altura_minima_tactil"
                    android:paddingEnd="14dp"
                    android:text="@string/accion_editar"
                    android:textAppearance="@style/TextAppearance.App.AccionTarjeta"
                    android:textColor="@color/brand_on_primary_container"
                    app:drawableStartCompat="@drawable/ic_editar_tarjeta"
                    app:drawableTint="@color/brand_on_primary_container" />

                <TextView
                    android:id="@+id/btn_estado_platillo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/altura_minima_tactil"
                    android:text="@string/accion_desactivar"
                    android:textAppearance="@style/TextAppearance.App.AccionTarjeta"
                    android:textColor="@color/brand_secondary"
                    app:drawableStartCompat="@drawable/ic_desactivar_tarjeta"
                    app:drawableTint="@color/brand_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
