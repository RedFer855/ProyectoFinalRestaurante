<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espaciado_minimo"
    android:minHeight="@dimen/altura_minima_tactil"
    app:cardBackgroundColor="@color/brand_surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/espaciado_campo">

        <TextView
            android:id="@+id/txt_numero_mesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Mesa 4" />

        <TextView
            android:id="@+id/txt_capacidad_mesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="6 personas" />

        <!-- Estado con color Y texto — nunca solo color. -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_estado_mesa"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_minimo"
            tools:text="Ocupada" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
