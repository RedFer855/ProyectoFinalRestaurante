<?xml version="1.0" encoding="utf-8"?>
<!--
  Inicio: saludo + tarjetas de estado filtradas por rol. El filtrado ya no vive acá (se
  movió a InicioViewModel, Plan Fase 3c, E9) — el Fragment solo pinta lo que el ViewModel ya
  decidió que es visible.

  RecyclerView + GridLayoutManager, con nestedScrollingEnabled=false puesto en código: la
  grilla vive dentro de un NestedScrollView, y con el scroll anidado apagado no compite con
  el scroll del contenedor — mismo resultado que el GridLayout que reemplaza, pero con
  ListAdapter + DiffUtil por debajo.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaciado_pantalla">

        <TextView
            android:id="@+id/txt_saludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Buenas tardes, Fernando" />

        <TextView
            android:id="@+id/txt_resumen_turno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_minimo"
            android:text="@string/inicio_resumen_turno"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grilla_tarjetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_campo"
            android:clipToPadding="false"
            tools:itemCount="7"
            tools:listitem="@layout/item_tarjeta_inicio"
            tools:spanCount="2" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
