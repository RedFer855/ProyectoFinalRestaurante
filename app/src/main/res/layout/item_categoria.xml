<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de una categoría dentro del diálogo de gestión (Fase 2a). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/altura_minima_tactil"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/espaciado_minimo">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_nombre_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Platos fuertes" />

        <TextView
            android:id="@+id/txt_conteo_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="12 platillos" />

        <TextView
            android:id="@+id/txt_estado_categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_categoria_desactivada"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_opciones_categoria"
        android:layout_width="@dimen/altura_minima_tactil"
        android:layout_height="@dimen/altura_minima_tactil"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_mas_opciones"
        android:src="@drawable/ic_mas_opciones" />

</LinearLayout>
