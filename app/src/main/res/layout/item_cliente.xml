<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaciado_minimo"
    app:cardBackgroundColor="@color/brand_surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espaciado_campo">

        <TextView
            android:id="@+id/txt_iniciales_cliente"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_iniciales"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            tools:text="AC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_campo"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_nombre_cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Ana Cruz" />

            <TextView
                android:id="@+id/txt_identidad_cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="0801199512345" />

            <TextView
                android:id="@+id/txt_telefono_cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="9988-1122" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_opciones_cliente"
            android:layout_width="@dimen/altura_minima_tactil"
            android:layout_height="@dimen/altura_minima_tactil"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_mas_opciones"
            android:src="@drawable/ic_mas_opciones" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
