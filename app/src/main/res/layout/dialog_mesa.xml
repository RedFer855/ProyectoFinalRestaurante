<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario de alta/edición de mesa. El estado operativo no se toca acá: se cambia desde
     la tarjeta (Plan Fase 2c, §4 — es la acción principal, no una opción del formulario). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/espaciado_pantalla"
        android:paddingTop="@dimen/espaciado_campo">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mesa_numero">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_form_numero_mesa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_campo"
            android:hint="@string/mesa_capacidad">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_form_capacidad_mesa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_campo"
            android:hint="@string/mesa_ubicacion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_form_ubicacion_mesa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/txt_form_error_mesa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_campo"
            android:layout_marginBottom="@dimen/espaciado_campo"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="El número de mesa debe ser mayor que cero."
            tools:visibility="visible" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
