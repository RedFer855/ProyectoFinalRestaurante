<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaciado_minimo"
    app:cardBackgroundColor="@color/brand_surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/espaciado_campo">

        <TextView
            android:id="@+id/txt_iniciales_empleado"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_iniciales"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            tools:text="MZ" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_campo"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_nombre_empleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Marta Zelaya" />

            <TextView
                android:id="@+id/txt_correo_empleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="marta.zelaya@restaurante.hn" />

            <TextView
                android:id="@+id/txt_identidad_empleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="0801199433221" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_minimo"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rol_empleado"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    tools:text="mesero" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_estado_empleado"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    tools:text="Activo" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_opciones_empleado"
            android:layout_width="@dimen/altura_minima_tactil"
            android:layout_height="@dimen/altura_minima_tactil"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_mas_opciones"
            android:src="@drawable/ic_mas_opciones" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
