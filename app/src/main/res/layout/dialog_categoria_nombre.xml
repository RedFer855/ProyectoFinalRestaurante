<?xml version="1.0" encoding="utf-8"?>
<!--
  Campo suelto para renombrar una categoría. Existe como layout propio porque antes se
  reutilizaba el de la lista escondiéndole la mitad de las vistas: eso se rompía cada vez
  que ese layout cambiaba, y ocultar vistas para reusar un layout esconde la intención.

  Usa el mismo estilo de campo que las hojas modales, con la etiqueta encima.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/espaciado_pantalla"
    android:paddingTop="@dimen/espaciado_campo">

    <TextView
        style="@style/Widget.App.EtiquetaCampo"
        android:text="@string/menu_categoria_nueva" />

    <EditText
        android:id="@+id/txt_categoria_nombre"
        style="@style/Widget.App.CampoModal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/menu_categoria_nueva_ejemplo"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1" />

</LinearLayout>
