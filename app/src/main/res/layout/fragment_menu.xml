<?xml version="1.0" encoding="utf-8"?>
<!--
  Menú conectado a Supabase (Fase 2a). La misma pantalla para los tres roles: todos ven el
  catálogo, pero solo admin ve el botón de agregar, el de categorías y el menú ⋮ de cada
  platillo. Quien impide de verdad que un mesero cambie un precio es la RLS de Postgres.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/espaciado_pantalla"
            android:layout_marginTop="@dimen/espaciado_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_buscar_platillo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/menu_buscar_platillo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_buscar_platillo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_categorias"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_minimo"
                android:minHeight="@dimen/altura_minima_tactil"
                android:text="@string/menu_categorias"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_minimo"
            android:paddingHorizontal="@dimen/espaciado_pantalla"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupo_categorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!--
          Estado global de la sincronización (Plan Fase 2b, §4.5): "N cambios sin subir",
          "Sincronizando cambios…" o el último error permanente. Se oculta entero cuando
          no hay nada que informar.
        -->
        <TextView
            android:id="@+id/txt_estado_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/espaciado_pantalla"
            android:layout_marginTop="@dimen/espaciado_minimo"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Sincronizando cambios…"
            tools:visibility="visible" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresco_menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_platillos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/espaciado_pantalla"
                android:paddingTop="@dimen/espaciado_campo"
                android:paddingBottom="@dimen/espaciado_lista_bajo_fab"
                tools:itemCount="4"
                tools:listitem="@layout/item_platillo" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txt_menu_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/espaciado_seccion"
        android:text="@string/menu_vacio"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_agregar_platillo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/espaciado_pantalla"
        android:text="@string/menu_agregar_platillo"
        app:icon="@drawable/ic_agregar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
